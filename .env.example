# ----------------------------------------------------------------------------
# Stripe configuration
# ----------------------------------------------------------------------------
# Copy this file to ".env.local" for local development and fill in a real key.
# ".env.local" is gitignored, so real keys never get committed.
#
# In production, set STRIPE_SECRET_KEY in the Vercel dashboard:
#   Project → Settings → Environment Variables → add for "Production"
#   (mark it Sensitive, then redeploy for it to take effect).
#
# Use a RESTRICTED key (rk_live_… for production, rk_test_… for testing) rather
# than your account secret key. Grant it the minimum permissions this app uses:
#
#   • Products .............. Read    (list products for the shop + best sellers)
#   • Prices ................ Read    (expand each product's default price)
#   • Checkout Sessions ..... Write   (create the hosted payment page)
#   • PaymentIntents ........ Write   (payment-mode Checkout creates a PaymentIntent)
#   • Everything else ....... None
#
# This key is used server-side only and is never exposed to the browser.
# No publishable key is needed — checkout is a server-side redirect to Stripe's
# hosted page, so Stripe.js never runs client-side.
STRIPE_SECRET_KEY=rk_test_replace_me

# ----------------------------------------------------------------------------
# Stripe webhook signing secret
# ----------------------------------------------------------------------------
# Powers instant cache refresh: when you add/edit/delete a product or price in
# Stripe, Stripe calls /api/stripe/webhook and the site re-fetches the catalog.
# Without it the site still works, but changes appear only after the 1-hour
# cache backstop.
#
# Create the endpoint in: Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL:    https://<your-production-domain>/api/stripe/webhook
#   Events: product.created, product.updated, product.deleted,
#           price.created,   price.updated,   price.deleted
# Copy the signing secret (whsec_…) here and into Vercel, then redeploy.
# (No extra restricted-key permissions are needed — this uses the secret below,
#  not an API key scope.)
STRIPE_WEBHOOK_SECRET=whsec_replace_me
